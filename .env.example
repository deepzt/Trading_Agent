# ─── Anthropic (Claude API) ────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Telegram Bot ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── Email Alerts (optional) ───────────────────────────────────
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_RECIPIENT=recipient@gmail.com

# ─── Broker (leave blank for paper trading) ────────────────────
# Zerodha Kite Connect (add when ready for live trading)
# KITE_API_KEY=
# KITE_API_SECRET=
# KITE_ACCESS_TOKEN=

# Angel One SmartAPI (alternative)
# ANGEL_API_KEY=
# ANGEL_CLIENT_ID=
# ANGEL_PASSWORD=
# ANGEL_TOTP_SECRET=

# ─── Trading Controls ──────────────────────────────────────────
TRADING_ENABLED=true          # Set to false to disable all order placement
PAPER_TRADING=true            # Always true until live broker is configured
ACCOUNT_SIZE=100000           # Initial paper trading capital in INR

# ─── Database ──────────────────────────────────────────────────
DATABASE_URL=sqlite:///data/trading.db

# ─── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
